sfgzt.cn {
	redir https://www.sfgzt.cn{uri} 308
}

www.sfgzt.cn {
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@standard_security not path /api/v1/bieyanghong-repair/novnc/*
	header @standard_security {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# noVNC is embedded only by the same-origin, token-gated repair page.
	@bieyanghong_novnc path /api/v1/bieyanghong-repair/novnc/*
	header @bieyanghong_novnc {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; img-src 'self' data:; font-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# Store 001: one-time, token-gated official-login repair browser.
	@bieyanghong_repair path /api/v1/bieyanghong-repair /api/v1/bieyanghong-repair/*
	handle @bieyanghong_repair {
		reverse_proxy 127.0.0.1:8091
	}

	# The Pilot browser sends the bearer token in this non-standard header.
	# Convert it only when present, so normal Authorization clients still work.
	@api_with_pilot_bearer {
		path /api /api/*
		header X-Hotel-AI-Authorization *
	}
	handle @api_with_pilot_bearer {
		reverse_proxy 127.0.0.1:18080 {
			header_up Authorization {http.request.header.X-Hotel-AI-Authorization}
			header_up -X-Hotel-AI-Authorization
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:18080
	}

	handle {
		root * /srv/www/hotel-ai-os/current
		try_files {path} /index.html
		file_server
	}
}
